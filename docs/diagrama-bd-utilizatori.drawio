t;" style="ellipse;shape=ellipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A5B60;fontSize=12;fontColor=#2B1B21;" vertex="1" parent="1"><mxGeometry x="3282" y="1519" width="104" height="44" as="geometry"/></mxCell><mxCell id="c284" style="endArrow=none;html=1;strokeColor=#6A5B60;" edge="1" parent="1" source="c283" target="c274"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c285" value="icon&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#6A5B60&quot;&gt;string&lt;/span&gt;" style="ellipse;shape=ellipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A5B60;fontSize=12;fontColor=#2B1B21;" vertex="1" parent="1"><mxGeometry x="3313" y="1628" width="104" height="44" as="geometry"/></mxCell><mxCell id="c286" style="endArrow=none;html=1;strokeColor=#6A5B60;" edge="1" parent="1" source="c285" target="c274"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c287" value="handled by" style="rhombus;shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#E3F1EC;strokeColor=#2D6B5D;strokeWidth=1.5;fontSize=13;fontColor=#2B1B21;" vertex="1" parent="1"><mxGeometry x="3092" y="2003" width="136" height="74" as="geometry"/></mxCell><mxCell id="c288" style="endArrow=none;html=1;strokeColor=#2B1B21;strokeWidth=1.5;" edge="1" parent="1" source="c287" target="c274"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c289" value="M" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#2B1B21;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="c288"><mxGeometry x="0.62" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c290" style="endArrow=none;html=1;strokeColor=#2B1B21;strokeWidth=1.5;" edge="1" parent="1" source="c287" target="c257"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c291" value="N" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#2B1B21;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="c290"><mxGeometry x="0.62" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c292" value="&lt;b style=&quot;font-size:15px&quot;&gt;Resonance: the complete database (Chen notation)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Rectangle: entity. Double rectangle: weak entity.&lt;br&gt;Diamond: relationship. Double diamond: identifying relationship.&lt;br&gt;Ellipse: attribute, with its type. Double ellipse: multivalued.&lt;br&gt;&lt;u&gt;Underlined&lt;/u&gt;: primary key. &lt;u style=&quot;text-decoration-style:dashed&quot;&gt;Dashed underline&lt;/u&gt;: partial key.&lt;br&gt;Double line: total participation (every instance takes part).&lt;br&gt;1, N, M: cardinality.&lt;br&gt;&lt;br&gt;Top: the products (lab 3). Middle: what users do with them.&lt;br&gt;Bottom: users, employees and the contact tables (labs 5 and 6)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#2B1B21;strokeColor=#6A5B60;fillColor=#FBFCFB;spacing=12;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="440" height="215" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
# Don't fill this in by hand: run  python genereaza_env.py  and it makes .env with random values.
# This file only shows which values .env holds. .env is in .gitignore: never commit it.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# The PostgreSQL container (compose.yaml)
POSTGRES_PASSWORD=
DB_NAME=resonance
DB_USER=resonance_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5433

# Used by: python manage.py createsuperuser --noinput
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@resonance.example
DJANGO_SUPERUSER_PASSWORD=
